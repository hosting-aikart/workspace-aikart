# ─────────────────────────────────────────────────────────────────────────────
# AIKart Employee Workspace — Server Environment Variables (EXAMPLE)
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5000

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Pooled connection — used by Prisma at runtime
DATABASE_URL='postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require'

# Direct (non-pooled) connection — required by Prisma for migrations
DIRECT_URL='postgresql://USER:PASSWORD@HOST-direct/neondb?sslmode=require&channel_binding=require'

# Shadow database — a separate, EMPTY database that `prisma migrate dev` /
# `migrate diff` replay migration history into to detect drift. Without it,
# those commands refuse to run and ask to reset your real database instead.
# Create an empty database on the same Postgres server (e.g. `CREATE DATABASE
# prisma_shadow_sync;`) and point this at it — Prisma wipes/recreates its
# contents on every run, so nothing but scratch state should live there.
SHADOW_DATABASE_URL='postgresql://USER:PASSWORD@HOST/prisma_shadow_sync?sslmode=require&channel_binding=require'

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_this_to_a_strong_random_secret_min_32_chars_access
JWT_REFRESH_SECRET=change_this_to_a_different_strong_random_secret_min_32_chars_refresh

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Cloudinary (profile photo uploads) ──────────────────────────────────────
# https://cloudinary.com/console → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Google OAuth (Gmail API) ─────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application type)
# 3. Under "Authorised redirect URIs" add: http://localhost:5000/api/google/callback
#    (and your production URL when deploying)
# 4. Enable the Gmail API under "Enabled APIs & services"
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# ─── Client Origin (used for OAuth redirect back to the React app) ────────────
# In development this is Vite's dev server. In production, set to your domain.
CLIENT_ORIGIN=http://localhost:5173
