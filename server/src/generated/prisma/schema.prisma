generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model Workspace {
  id          String  @id @default(cuid())
  name        String
  description String?

  users             User[]
  departments       Department[]
  projects          Project[]
  announcements     Announcement[]
  meetings          Meeting[]
  chatConversations ChatConversation[]
  notifications     Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id   String @id @default(cuid())
  name String

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
}

model User {
  id String @id @default(cuid())

  name String?

  email String @unique

  passwordHash String

  role Role

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // ── Employee profile fields ──────────────────────────────────────────
  employeeId  String?
  phone       String?
  position    String?
  joiningDate DateTime?
  location    String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  reportingManagerId String?
  reportingManager   User?   @relation("ReportsTo", fields: [reportingManagerId], references: [id])
  directReports      User[]  @relation("ReportsTo")

  isActive Boolean @default(true)

  mustChangePassword Boolean @default(true)

  lastLogin DateTime?

  profilePhoto String?

  createdById String?
  createdBy   User?   @relation("CreatedUsers", fields: [createdById], references: [id])

  createdUsers          User[]                   @relation("CreatedUsers")
  attendances           Attendance[]
  createdProjects       Project[]                @relation("ProjectCreatedBy")
  managedProjects       Project[]                @relation("ProjectManager")
  projectMembers        ProjectMember[]
  createdTasks          Task[]                   @relation("TaskCreatedBy")
  assignedTasks         Task[]                   @relation("TaskAssignedTo")
  createdAnnouncements  Announcement[]           @relation("AnnouncementCreatedBy")
  announcementTargets   AnnouncementTargetUser[]
  announcementReads     AnnouncementRead[]
  googleAccount         GoogleAccount?
  organizedMeetings     Meeting[]                @relation("MeetingOrganizer")
  meetingParticipations MeetingParticipant[]

  createdChatConversations ChatConversation[] @relation("ChatConversationCreatedBy")
  chatParticipations       ChatParticipant[]
  chatMessages             ChatMessage[]      @relation("ChatMessageSender")

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, employeeId])
}

enum AttendanceStatus {
  NOT_STARTED
  WORKING
  PAUSED
  CHECKED_OUT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  ITERATE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Attendance {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  date DateTime // normalized to midnight — one record per user per calendar day

  checkIn  DateTime?
  checkOut DateTime?

  totalSeconds Int @default(0) // accumulated worked time for the day, in seconds

  status AttendanceStatus @default(NOT_STARTED)

  timerSegments TimerSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model TimerSegment {
  id String @id @default(cuid())

  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id])

  startedAt DateTime
  endedAt   DateTime? // null while this segment is still running (active work or currently paused)

  createdAt DateTime @default(now())
}

model Project {
  id String @id @default(cuid())

  name        String
  description String?
  status      String    @default("ACTIVE")
  priority    String    @default("MEDIUM")
  progress    Int       @default(0)
  startDate   DateTime?
  deadline    DateTime?
  isArchived  Boolean   @default(false)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdById String?
  createdBy   User?   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id])

  members ProjectMember[]
  tasks   Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
}

model ProjectMember {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Task {
  id String @id @default(cuid())

  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdById String?
  createdBy   User?   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assignedToId])
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AnnouncementTargetType {
  ALL
  SELECTED_USERS
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Announcement {
  id          String                 @id @default(cuid())
  title       String
  description String
  priority    AnnouncementPriority   @default(MEDIUM)
  targetType  AnnouncementTargetType @default(ALL)
  status      AnnouncementStatus     @default(PUBLISHED)
  publishDate DateTime               @default(now())
  expiryDate  DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdById String?
  createdBy   User?   @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])

  selectedUsers AnnouncementTargetUser[]
  readRecords   AnnouncementRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnnouncementTargetUser {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([announcementId, userId])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isRead Boolean  @default(true)
  readAt DateTime @default(now())

  @@unique([announcementId, userId])
}

// ─── Google OAuth ─────────────────────────────────────────────────────────────

model GoogleAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail  String
  accessToken  String
  refreshToken String?
  expiryDate   DateTime?
  scope        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── Meeting Module ────────────────────────────────────────────────────────────

enum MeetingStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum MeetingType {
  SCHEDULED
  INSTANT
}

enum ParticipantResponseStatus {
  INVITED
  ACCEPTED
  DECLINED
  JOINED
}

model Meeting {
  id          String  @id @default(cuid())
  title       String
  description String?
  agenda      String?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  organizerId String
  organizer   User   @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  meetingType MeetingType   @default(SCHEDULED)
  status      MeetingStatus @default(UPCOMING)

  googleEventId     String?
  googleMeetSpaceId String?
  meetingUrl        String?

  startTime DateTime
  endTime   DateTime

  participants MeetingParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([organizerId])
}

enum ParticipantType {
  INTERNAL
  EXTERNAL
}

model MeetingParticipant {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email           String?
  participantType ParticipantType @default(INTERNAL)

  responseStatus ParticipantResponseStatus @default(INVITED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meetingId, userId])
}

// ─── Chat Module ───────────────────────────────────────────────────────────────

enum ChatConversationType {
  DIRECT
  GROUP
}

model ChatConversation {
  id        String               @id @default(cuid())
  type      ChatConversationType @default(GROUP)
  name      String?
  isDefault Boolean              @default(false) // workspace-wide "Team Chat" — open to every member

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("ChatConversationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  participants  ChatParticipant[]
  messages      ChatMessage[]
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model ChatParticipant {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime?

  createdAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String?
  sender   User?   @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  // `content` may be empty when the message is an image with no caption —
  // one of content or the attachment fields is always present, enforced in
  // chat.service.js rather than at the DB level (Prisma has no cross-column
  // CHECK constraint support).
  content String

  // Single-image attachment, stored on Cloudinary — see profile photo
  // upload for the same pattern. Kept as three flat nullable columns
  // instead of a separate Attachment table since a chat message can only
  // carry one image today; revisit if multi-file attachments are added.
  attachmentUrl  String?
  attachmentType String? // MIME type, e.g. "image/png"
  attachmentName String? // original filename, for download/alt text

  // True when this message was created by forwarding another message's
  // content/attachment into this conversation (see forwardMessages in
  // chat.service.js) — drives the "Forwarded" label on the client.
  isForwarded Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
}

// ─── Notification Module ────────────────────────────────────────────────────
// Personal, per-user activity feed — distinct from Announcement (a broadcast
// admin/manager post everyone can browse). A Notification is a private
// pointer at something that happened ("X published an announcement", "Y sent
// you a message"), generated by the events below and pushed live over
// Socket.IO to the owning user's `user:<id>` room.

enum NotificationType {
  ANNOUNCEMENT
  CHAT_MESSAGE
  MEETING_INVITE
  GROUP_INVITE
  PROJECT_INVITE
  TASK_ASSIGNED
  SYSTEM
}

model Notification {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType @default(SYSTEM)
  title String
  body  String?

  // Client-side route to open when the notification is clicked, e.g. /app/chat.
  link     String?
  // id of the source record (announcement/conversation/meeting) for reference.
  entityId String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([workspaceId, userId, createdAt])
  @@index([userId, isRead])
}
