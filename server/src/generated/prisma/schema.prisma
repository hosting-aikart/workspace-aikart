generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model Workspace {
  id          String  @id @default(cuid())
  name        String
  description String?

  users         User[]
  departments   Department[]
  projects      Project[]
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id   String @id @default(cuid())
  name String

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
}

model User {
  id String @id @default(cuid())

  name String?

  email String @unique

  passwordHash String

  role Role

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // ── Employee profile fields ──────────────────────────────────────────
  employeeId  String?
  phone       String?
  position    String?
  joiningDate DateTime?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  reportingManagerId String?
  reportingManager   User?   @relation("ReportsTo", fields: [reportingManagerId], references: [id])
  directReports      User[]  @relation("ReportsTo")

  isActive Boolean @default(true)

  mustChangePassword Boolean @default(true)

  lastLogin DateTime?

  profilePhoto String?

  createdById String?
  createdBy   User?   @relation("CreatedUsers", fields: [createdById], references: [id])

  createdUsers         User[]                   @relation("CreatedUsers")
  attendances          Attendance[]
  createdProjects      Project[]                @relation("ProjectCreatedBy")
  managedProjects      Project[]                @relation("ProjectManager")
  projectMembers       ProjectMember[]
  createdTasks         Task[]                   @relation("TaskCreatedBy")
  createdAnnouncements Announcement[]           @relation("AnnouncementCreatedBy")
  announcementTargets  AnnouncementTargetUser[]
  announcementReads    AnnouncementRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, employeeId])
}

enum AttendanceStatus {
  NOT_STARTED
  WORKING
  PAUSED
  CHECKED_OUT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  ITERATE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Attendance {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  date DateTime // normalized to midnight — one record per user per calendar day

  checkIn  DateTime?
  checkOut DateTime?

  totalSeconds Int @default(0) // accumulated worked time for the day, in seconds

  status AttendanceStatus @default(NOT_STARTED)

  timerSegments TimerSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model TimerSegment {
  id String @id @default(cuid())

  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id])

  startedAt DateTime
  endedAt   DateTime? // null while this segment is still running (active work or currently paused)

  createdAt DateTime @default(now())
}

model Project {
  id String @id @default(cuid())

  name        String
  description String?
  status      String    @default("ACTIVE")
  priority    String    @default("MEDIUM")
  progress    Int       @default(0)
  startDate   DateTime?
  deadline    DateTime?
  isArchived  Boolean   @default(false)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdById String?
  createdBy   User?   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id])

  members ProjectMember[]
  tasks   Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
}

model ProjectMember {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Task {
  id String @id @default(cuid())

  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdById String?
  createdBy   User?   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AnnouncementTargetType {
  ALL
  SELECTED_USERS
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Announcement {
  id          String                 @id @default(cuid())
  title       String
  description String
  priority    AnnouncementPriority   @default(MEDIUM)
  targetType  AnnouncementTargetType @default(ALL)
  status      AnnouncementStatus     @default(PUBLISHED)
  publishDate DateTime               @default(now())
  expiryDate  DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdById String?
  createdBy   User?   @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])

  selectedUsers AnnouncementTargetUser[]
  readRecords   AnnouncementRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnnouncementTargetUser {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([announcementId, userId])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isRead Boolean  @default(true)
  readAt DateTime @default(now())

  @@unique([announcementId, userId])
}
