# AIKart Workspace Mobile - Environment Variables Example
# Copy to .env.development or .env.production

# Backend REST API URL (Must include /api)
# For physical Android phone via Wi-Fi: http://<YOUR_LOCAL_COMPUTER_IP>:5000/api
# For Android Emulator: http://10.0.2.2:5000/api
# For Production: https://your-workspace-domain.com/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api
